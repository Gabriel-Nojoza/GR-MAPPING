# Endereço público da VPS. Use o IP enquanto não houver domínio.
NEXT_PUBLIC_API_URL=http://SEU_IP_DA_VPS:8001
CORS_ORIGINS=http://SEU_IP_DA_VPS:3001

# Use portas livres na VPS, diferentes das usadas pelo outro projeto.
FRONT_PORT=3001
API_PORT=8001

# Segredos: preencha somente na VPS; não envie este arquivo ao Git.
GEMINI_API_KEY=
LOGIN_USER_1_EMAIL=
LOGIN_USER_1_PASSWORD=
LOGIN_USER_2_EMAIL=
LOGIN_USER_2_PASSWORD=

# WhatsApp / Evolution API. Gere senhas fortes somente na VPS.
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=
EVOLUTION_INSTANCE=imobiliaria

# Lembretes automáticos de aluguel. Deixe false até confirmar o WhatsApp.
COBRANCA_LEMBRETES_AUTOMATICOS=false
COBRANCA_HORA_LEMBRETE=9
